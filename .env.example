# Copy to .env for local development (both `npm run dev` and the db:* scripts
# read it; it is gitignored).
# On Vercel, set these under Project → Settings → Environment Variables.

# Postgres. Locally: `docker compose up -d` and use the line below.
# On Vercel the Neon integration sets DATABASE_URL (pooled) and
# DATABASE_URL_UNPOOLED (direct, used for migrations) for you.
DATABASE_URL=postgres://flitz:flitz@localhost:5433/studio
# DATABASE_URL_UNPOOLED=

# The only email address that can log in. Also receives the alerts.
ADMIN_EMAIL=info@flitzweb.nl
# Optional: send alerts somewhere else.
# ALERT_EMAIL=

# Signs the login cookie. At least 32 characters. Generate with: openssl rand -base64 32
AUTH_SECRET=
# Optional but recommended: a separate secret for the anonymous visitor ids (keeps them apart
# from the login secret). Generate the same way. Setting it later starts new visitor ids once.
# ANALYTICS_SECRET=

# Public URL of this dashboard, used in magic links and alert emails.
APP_URL=http://localhost:3000

# Resend (https://resend.com). Without a key, emails are printed to the
# terminal instead, which is handy in development.
RESEND_API_KEY=
# Must be on a domain you verified in Resend.
EMAIL_FROM=FlitzWeb Studio <studio@flitzweb.nl>
# Optional: a second Resend key just for alerts (site down, SSL, overdue, spikes), so login
# emails can never use up the sending limit the alerts need.
# RESEND_ALERTS_API_KEY=

# Optional: events one site may store per day (default 20000).
# SITE_DAILY_EVENT_LIMIT=

# Protects /api/cron/check. Send it as: Authorization: Bearer <CRON_SECRET>
# Generate with: openssl rand -hex 24
CRON_SECRET=

# Optional. Lets the Versies tab read private site repos and publish a concept
# ("Zet live" = merge the concept branch into main). A fine-grained GitHub token
# limited to the site repos, with "Contents: Read and write".
GITHUB_TOKEN=
