# Copy to .env for local development (both `npm run dev` and the db:* scripts
# read it; it is gitignored).
# On Vercel, set these under Project → Settings → Environment Variables.

# Postgres. Locally: `docker compose up -d` and use the line below.
# On Vercel the Neon integration sets DATABASE_URL (pooled) and
# DATABASE_URL_UNPOOLED (direct, used for migrations) for you.
DATABASE_URL=postgres://flitz:flitz@localhost:5433/studio
# DATABASE_URL_UNPOOLED=

# The only email address that can log in. Also receives the alerts.
ADMIN_EMAIL=info@flitzweb.nl
# Optional: send alerts somewhere else.
# ALERT_EMAIL=

# Signs the login cookie. Generate with: openssl rand -base64 32
AUTH_SECRET=

# Public URL of this dashboard, used in magic links and alert emails.
APP_URL=http://localhost:3000

# Resend (https://resend.com). Without a key, emails are printed to the
# terminal instead, which is handy in development.
RESEND_API_KEY=
# Must be on a domain you verified in Resend.
EMAIL_FROM=FlitzWeb Studio <studio@flitzweb.nl>

# Protects /api/cron/check. Send it as: Authorization: Bearer <CRON_SECRET>
# Generate with: openssl rand -hex 24
CRON_SECRET=
